# Postgres connection string (must be a host that signs a HIPAA BAA in production)
DATABASE_URL=postgres://postgres@localhost:5432/compoundsource
# Public address of the site, used in email links
APP_URL=http://localhost:3000
# Where new sign-ups and orders are announced (no patient details are ever emailed)
ADMIN_NOTIFY_EMAIL=you@example.com
# Optional: Resend API key for sending email. Without it, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=CompoundSource <orders@example.com>
